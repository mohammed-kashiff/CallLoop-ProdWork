# Optional. Leave unset for local demo (http://localhost:8000).
VITE_API_URL=http://localhost:8000

# Supabase Auth (CL-8). Anon key is public by design; still do not commit production values.
# Never add SUPABASE_SERVICE_ROLE_KEY here (server only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CallLoop's own Intercom support widget (unrelated to the OAuth
# integration that pulls customer data in). app_id is public by design —
# it's Intercom's own installation identifier, meant to ship in client-side
# JS. Leave unset to skip mounting the widget entirely. The signed
# identity check (Messenger Security) is a server-only secret —
# INTERCOM_MESSENGER_SECRET on the backend, never here.
VITE_INTERCOM_APP_ID=

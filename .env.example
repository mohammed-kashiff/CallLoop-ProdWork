# Copy to a gitignored .env on this machine, or set the same names on the host
# (Render Environment). Never commit real keys. This file has empty placeholders only.

# Supabase Postgres (CL-4 schema). URI from Connect → Session pooler (or Direct).
# Never commit this value. Render: Environment on callloop-prodwork (not a Secret File).
# API SET LOCAL ROLE callproof_app (NOBYPASSRLS) after connect — postgres URI
# is fine here because Alembic needs bypass. Do not use bypass_rls=True in the API.
DATABASE_URL=
# Optional alias; DATABASE_URL wins if both are set.
SUPABASE_DB_URL=

# Supabase Auth (CL-8). API verifies Bearer JWTs. Never commit real values.
# Project URL (https://<ref>.supabase.co) — JWT issuer is {URL}/auth/v1
SUPABASE_URL=
# JWT secret from Project Settings → API (HS256). Leave blank to verify ES256/RS256 via JWKS.
SUPABASE_JWT_SECRET=
# Service role (server only). Uploads + signed URLs for private call-audio.
# Never put this in the frontend or VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for per-org objects {org_id}/{call_id}.mp3 (default: call-audio).
AUDIO_STORAGE_BUCKET=call-audio
# Signed URL lifetime in seconds (60–86400). Default 3600.
AUDIO_SIGNED_URL_TTL=3600

PYAI_API_KEY=
ANTHROPIC_API_KEY=

# hybrid (default): channel/greeting roles; Claude for Resolution + Churn (parallel).
# full: same roles, plus tone LLM, ownership step-2 LLM, and churn.
# Areas of improvement (agent + product) are on-demand, not first load.
AUDIT_MODE=hybrid

# Optional Recap pack (live PyAI key with recap scopes).
RECAP_PACK_ID=

# Hear async job polling (seconds / attempts). Defaults: 3s × 200 ≈ 10 minutes.
HEAR_POLL_INTERVAL_SECONDS=3
HEAR_POLL_MAX_ATTEMPTS=200

# Optional override if imageio-ffmpeg is not used.
FFMPEG_PATH=

# Browser origins allowed to call the API (comma-separated).
# Defaults: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=

# Optional stakeholder / SMTP (Gmail compose is the primary UI path).
STAKEHOLDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CLI-only: python transcribe.py uses this if no file path is passed.
CALLPROOF_CLI_AUDIO=

# Operator alerts on HTTP 5xx / unhandled API crashes (not 4xx).
# Desktop: macOS Notification Center. Default on for Darwin; set false to disable.
ERROR_NOTIFY_DESKTOP=true
# Optional Slack-style incoming webhook (URL is a secret — never commit it).
ERROR_NOTIFY_WEBHOOK_URL=
# Just your address, or extra addresses (comma-separated). Defaults are already
# in the app. Set to off to disable email alerts.
# ERROR_NOTIFY_EMAIL=off
ERROR_NOTIFY_EMAIL=
# Collapse repeat alerts for the same method+path+status (seconds).
ERROR_NOTIFY_MIN_INTERVAL_SECONDS=60

# Optional operator JustCall ingest (webhook/poller for JUSTCALL_ORG_ID).
# Customer orgs save their own key on Integrations (encrypted in Vault).
# Never commit real values.
JUSTCALL_API_KEY=
JUSTCALL_API_SECRET=
# Optional HMAC for POST /api/integrations/justcall/webhook. Leave blank for
# local polling-only (JustCall cannot reach 127.0.0.1 without a tunnel).
JUSTCALL_WEBHOOK_SECRET=
# Org for webhook/poller ingest (no JWT). Leave blank to use the placeholder org.
JUSTCALL_ORG_ID=
# Background poll interval when key+secret are set (15–3600 seconds).
JUSTCALL_POLL_SECONDS=45

# Per-call: audio minutes × COST_PYAI_USD_PER_MINUTE + audit × COST_CLAUDE_USD_PER_AUDIT
# Today widget: PyAI units × COST_PYAI_USD_PER_UNIT (else actions × per-minute) + Claude hits × per-hit
COST_PYAI_USD_PER_MINUTE=0.01
COST_PYAI_USD_PER_UNIT=0.01
COST_CLAUDE_USD_PER_AUDIT=0.06
COST_CLAUDE_USD_PER_HIT=0.02

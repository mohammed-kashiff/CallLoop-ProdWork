# secrets & environment — never commit. Copy .env.example → .env locally.
.env
.env.*
!.env.example
frontend/.env
!frontend/.env.example
.venv/

# python
__pycache__/
*.pyc

# leftover local file if present; the API does not open SQLite
callproof.db
# leftover local recordings (backfill into Storage, then delete)
audio/

# local runtime logs (rotating file under logs/)
logs/

# pytest
.pytest_cache/

# node / frontend build
node_modules/
frontend/node_modules/
frontend/dist/

# macOS
.DS_Store
